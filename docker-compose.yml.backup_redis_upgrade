version: '3.8'

services:
  streamlit:
    build: .
    ports:
      - "8501:8501"
    volumes:
      - ./data:/app/data
      - ./logs:/app/logs
    env_file:
      - .env
    command: streamlit run app.py
    
  fastapi:
    build: .
    ports:
      - "8000:8000"
    volumes:
      - ./data:/app/data
    env_file:
      - .env
    command: uvicorn search_api.main:app --host 0.0.0.0 --port 8000
    
  admin:
    build: .
    ports:
      - "5000:5000"
    env_file:
      - .env
    command: python app_admin.py
    
  scheduler:
    build: .
    env_file:
      - .env
    command: python -c "from scheduler import scheduler_manager; scheduler_manager.start(); import time; time.sleep(31536000)"
    depends_on:
      - streamlit
      - fastapi