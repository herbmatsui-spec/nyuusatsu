# .env.example
# 環境変数のサンプルファイル
# このファイルを .env にコピーして実際の値を設定してください

# LLM Provider (deepseek or gemini)
LLM_PROVIDER=deepseek

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_key_here

# Gemini API (optional)
GEMINI_API_KEY=your_gemini_key_here

# OCR (OCR_PROVIDER: 'tesseract' or 'azure')
OCR_PROVIDER=tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=jpn
OCR_DPI=300
OCR_MAX_PAGES=50
OCR_CONFIDENCE_THRESHOLD=0.6

# Azure Document Intelligence (optional — OCR_PROVIDER=azure の場合)
AZURE_DOCUMENTINTELLIGENCE_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com/
AZURE_DOCUMENTINTELLIGENCE_KEY=your_key_here

# ログレベル
LOG_LEVEL=INFO

# テキスト処理設定
MAX_TEXT_CHARS=12000
ENABLE_SMART_CHUNKING=true

# レート制限
DEEPSEEK_RATE_LIMIT=100
GEMINI_RATE_LIMIT=50

# データベース (SQLite または PostgreSQL)
DATABASE_URL=sqlite:///./bids_system.db

# 認証 (ENABLE_AUTH=true でログイン必須)
ENABLE_AUTH=false
SESSION_TIMEOUT_MIN=60
# 複数ユーザーはJSONで指定: [{"username":"alice","password":"pw123"}, ...]
ALLOWED_USERS_JSON=

# アプリ側レートリミット (1分あたりのアップロード上限)
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS_PER_MIN=10