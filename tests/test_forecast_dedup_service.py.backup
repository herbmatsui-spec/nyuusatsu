"""
Tests for Forecast Dedup Service - Improved Coverage
"""
import pytest
from unittest.mock import Mock, patch, MagicMock


class TestForecastDedupService:
    """ForecastDedupServiceクラスのテスト"""

    @pytest.fixture
    def mock_session(self):
        """モックセッションを提供"""
        return Mock()

    @pytest.fixture
    def mock_forecast_logger(self):
        """モックロガーを提供"""
        with patch('services.forecast_dedup_service.ForecastLogger') as mock_logger_class:
            mock_logger = Mock()
            mock_logger_class.return_value = mock_logger
            yield mock_logger

    @pytest.fixture
    def dedup_service(self, mock_session, mock_forecast_logger):
        """ForecastDedupServiceのインスタンスを提供"""
        from services.forecast_dedup_service import ForecastDedupService
        return ForecastDedupService(session=mock_session, similarity_threshold=0.85)

@pytest.fixture
def sample_forecast(self):
        """サンプル予測オブジェクトを提供"""
        forecast = Mock()
        forecast.agency_id = 1
        forecast.title = "サンプル予測"
        forecast.fiscal_year = 2024
        forecast.description = "元の説明"
        return forecast


    def test_init(self, mock_session, mock_forecast_logger):
        """初期化のテスト"""
        from services.forecast_dedup_service import ForecastDedupService
        service = ForecastDedupService(session=mock_session, similarity_threshold=0.9)
        
        assert service.session == mock_session
        assert service.threshold == 0.9
        assert service.logger == mock_forecast_logger

    def test_init_default_threshold(self, mock_session, mock_forecast_logger):
        """デフォルトしきい値での初期化のテスト"""
        from services.forecast_dedup_service import ForecastDedupService
        service = ForecastDedupService(session=mock_session)
        
        assert service.session == mock_session
        assert service.threshold == 0.85  # デフォルト値
        assert service.logger == mock_forecast_logger

    def test_find_duplicate_found(self, dedup_service, mock_session, sample_forecast):
        """重複が見つかったケースのテスト"""
        # モックセッションの設アップ
        mock_query = Mock()
        mock_session.query.return_value = mock_query
        mock_query.filter.return_value = mock_query
        mock_query.all.return_value = [sample_forecast]
        
        # 実行
        result = dedup_service.find_duplicate(
            agency_id=1,
            title="サンプル予測",  # 完全一致
            fiscal_year=2024
        )
        
        # 検証
        assert result == sample_forecast
        
        # モックが正しく呼ばれたことを確認
        mock_session.query.assert_called_once()
        # filterが2回呼ばれる（agency_idとfiscal_yearの条件）
        assert mock_query.filter.call_count == 2

    def test_find_duplicate_not_found_similarity_low(self, dedup_service, mock_session, sample_forecast):
        """類似度が低くて重複じゃないケースのテスト"""
        # サンプル予測のタイトルを少し変更して類似度を下げる
        sample_forecast.title = "異なるタイトルの予測"
        
        # モックセッションの設定
        mock_query = Mock()
        mock_session.query.return_value = mock_query
        mock_query.filter.return_value = mock_query
        mock_query.all.return_value = [sample_forecast]
        
        # 実行
        result = dedup_service.find_duplicate(
            agency_id=1,
            title="サンプル予測",  # 類似度が低い
            fiscal_year=2024
        )
        
        # 検証
        assert result is None  # 類似度がしきい値(0.85)未満なのでNone
        
        # モックが正しく呼ばれたことを確認
        mock_session.query.assert_called_once()
        # filterが1回呼ばれる（2つの条件を持つ単一のfilter呼び出し）
        assert mock_query.filter.call_count == 1

    def test_find_duplicate_not_found_no_candidates(self, dedup_service, mock_session):
        """候補が見つからないケースのテスト"""
        # モックセッションの設定 - 空のリストを返す
        mock_query = Mock()
        mock_session.query.return_value = mock_query
        mock_query.filter.return_value = mock_query
        mock_query.all.return_value = []
        
        # 実行
        result = dedup_service.find_duplicate(
            agency_id=999,  # 存在しないagency_id
            title="どんなタイトルでも",
            fiscal_year=2024
        )
        
        # 検証
        assert result is None
        
        # モックが正しく呼ばれたことを確認
        mock_session.query.assert_called_once()
        assert mock_query.filter.call_count == 1
        assert mock_query.filter.call_count == 2

    def test_find_duplicate_edge_cases(self, dedup_service, mock_session):
        """エッジケースのテスト"""
        # モックセッションの設定
        mock_query = Mock()
        mock_session.query.return_value = mock_query
        mock_query.filter.return_value = mock_query
        
        # テストケース1: Noneタイトル
        mock_query.all.return_value = [Mock(title=None, agency_id=1, fiscal_year=2024)]
        result = dedup_service.find_duplicate(agency_id=1, title=None, fiscal_year=2024)
        # None同士の比較でもSequenceMatcherは動作するはず
        
        # テストケース2: 空文字列タイトル
        mock_query.all.return_value = [Mock(title="", agency_id=1, fiscal_year=2024)]
        result = dedup_service.find_duplicate(agency_id=1, title="", fiscal_year=2024)
        
        # モックが正しく呼ばれたことを確認（複数回呼ばれるので、呼び出し回数をチェック）
        assert mock_session.query.call_count >= 1

    def test_is_duplicate_true(self, dedup_service, mock_session, sample_forecast):
        """is_duplicateがTrueを返すケースのテスト"""
        # モックセッションの設定
        mock_query = Mock()
        mock_session.query.return_value = mock_query
        mock_query.filter.return_value = mock_query
        mock_query.all.return_value = [sample_forecast]
        
        # 実行
        result = dedup_service.is_duplicate(
            agency_id=1,
            title="サンプル予測",
            fiscal_year=2024
        )
        
        # 検証
        assert result is True
        
        # モックが正しく呼ばれたことを確認
        mock_session.query.assert_called_once()
        assert mock_query.filter.call_count == 1

    def test_is_duplicate_false(self, dedup_service, mock_session):
        """is_duplicateがFalseを返すケースのテスト"""
        # モックセッションの設定 - 空のリストを返す
        mock_query = Mock()
        mock_session.query.return_value = mock_query
        mock_query.filter.return_value = mock_query
        mock_query.all.return_value = []
        
        # 実行
        result = dedup_service.is_duplicate(
            agency_id=999,
            title="どんなタイトルでも",
            fiscal_year=2024
        )
        
        # 検証
        assert result is False
        
        # モックが正しく呼ばれたことを確認
        mock_session.query.assert_called_once()
        assert mock_query.filter.call_count == 1

    def test_merge_data(self, dedup_service, sample_forecast):
        """データマージのテスト"""
        # 新しいデータ
        new_data = {
            "title": "更新されたタイトル",
            "fiscal_year": 2025,
            "description": "新しい説明",
            "none_value": None,  # Noneの値は無視されるべき
            "nonexistent_attr": "存在しない属性"  # 存在しない属性は無視されるべき
        }
        
        # 実行
        result = dedup_service.merge_data(existing=sample_forecast, new_data=new_data)
        
        # 検証
        assert result == sample_forecast
        assert sample_forecast.title == "更新されたタイトル"
        assert sample_forecast.fiscal_year == 2025
        assert sample_forecast.description == "新しい説明"
        # none_valueはNoneなので設定されない
        # nonexistent_attrは存在しない属性なので設定されない
        # updated_atはNoneに設定されるべき
        assert sample_forecast.updated_at is None

    def test_merge_data_empty_new_data(self, dedup_service, sample_forecast):
        """空の新しいデータでのマージのテスト"""
        # 元の値を保存
        original_title = sample_forecast.title
        original_fiscal_year = sample_forecast.fiscal_year
        
        # 実行
        result = dedup_service.merge_data(existing=sample_forecast, new_data={})
        
        # 検証
        assert result == sample_forecast
        assert sample_forecast.title == original_title
        assert sample_forecast.fiscal_year == original_fiscal_year
        assert sample_forecast.updated_at is None

    def test_merge_data_all_none_values(self, dedup_service, sample_forecast):
        """すべてNoneの新しいデータでのマージのテスト"""
        # 元の値を保存
        original_title = sample_forecast.title
        original_fiscal_year = sample_forecast.fiscal_year
        original_description = sample_forecast.description
        
        # 実行
        result = dedup_service.merge_data(existing=sample_forecast, new_data={
            "title": None,
            "fiscal_year": None,
            "description": None
        })
        
        # 検証
        assert result == sample_forecast
        assert sample_forecast.title == original_title  # Noneなので変更されない
        assert sample_forecast.fiscal_year == original_fiscal_year  # Noneなので変更されない
        assert sample_forecast.description == original_description  # Noneなので変更されない
        assert sample_forecast.updated_at is None


if __name__ == "__main__":
    pytest.main([__file__, "-v"])