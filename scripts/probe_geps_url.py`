import requests
from bs4 import BeautifulSoup
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("GEPS_URL_Probe")

def probe_geps_search():
    # GEPSの基本検索URL (実際にはPOSTや複雑なクエリになることが多いが、まずは構造を確認)
    base_url = "https://www.geps.go.jp/index.html"
    
    try:
        logger.info(f"Probing {base_url}...")
        response = requests.get(base_url, timeout=10)
        response.raise_for_status()
        
        soup = BeautifulSoup(response.text, 'html.parser')
        
        # 検索フォームの構造を確認
        forms = soup.find_all('form')
        logger.info(f"Found {len(forms)} forms on the page.")
        
        for i, form in enumerate(forms):
            action = form.get('action') or 'same page'
            method = form.get('method', 'get').upper()
            logger.info(f"Form {i}: Action={action}, Method={method}")
            
            inputs = form.find_all(['input', 'select', 'textarea'])
            for inp in inputs:
                name = inp.get('name')
                value = inp.get('value')
                logger.info(f"  Input: name={name}, value={value}")
                
    except Exception as e:
        logger.error(f"Error during probing: {e}")

if __name__ == "__main__":
    probe_geps_search()
